{
  "name": "commentary",
  "displayName": "Commentary",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commentary.reviewSelection",
        "title": "Review Selection"
      },
      {
        "command": "commentary.setApiKey",
        "title": "Set Google AI Studio API Key"
      },
      {
        "command": "commentary.addLoremIpsumComment",
        "title": "Developer: Add Lorem Ipsum Comment"
      },
      {
        "command": "commentary.elaborateComment",
        "title": "Elaborate AI Comment",
        "icon": "$(sparkle)"
      },
      {
        "command": "commentary.dismissComment",
        "title": "Dismiss AI Comment",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "commentary.dismissComment",
          "when": "commentThread == aiCodeComment",
          "group": "inline"
        },
        {
          "command": "commentary.elaborateComment",
          "when": "commentThread == aiCodeComment",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
